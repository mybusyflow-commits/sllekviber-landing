# Set both before using the admin dashboard.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Serverless production: connect Neon in Vercel Storage and set this server-only URL.
# Leave blank for local SQLite. Run npm run db:setup before accepting hosted polls.
DATABASE_URL=
# Optional local SQLite override:
# SLEEKVIBER_DB_PATH=data/survey.db
